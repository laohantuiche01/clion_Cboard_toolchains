+package com.github.waveformplotter
+
+import com.intellij.openapi.actionSystem.AnActionEvent
+import com.intellij.openapi.actionSystem.ActionUpdateThread
+import com.intellij.xdebugger.impl.ui.tree.actions.XDebuggerTreeActionBase
+import com.intellij.xdebugger.impl.ui.tree.nodes.XValueNodeImpl
+import javax.swing.SwingUtilities
+
+/** Uses the debugger's full expression, including parent members and indices. */
+class PlotDebuggerVariableAction : XDebuggerTreeActionBase() {
+    override fun getActionUpdateThread(): ActionUpdateThread = ActionUpdateThread.EDT
+
+    override fun perform(node: XValueNodeImpl, nodeName: String, e: AnActionEvent) {
+        val project = e.project ?: return
+        node.calculateEvaluationExpression().onSuccess { expression ->
+            val text = expression?.expression?.trim().orEmpty()
+            if (text.isNotEmpty()) SwingUtilities.invokeLater {
+                WaveformToolWindowFactory.withPanel(project) { it.addVariableByName(text) }
+            }
+        }
+    }
+}
