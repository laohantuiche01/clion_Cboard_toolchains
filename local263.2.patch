@@ -0,0 +1,45 @@
+package com.github.waveformplotter
+
+/** A fixed-duration viewport that follows the latest acquired frame. */
+class StreamingTimeWindow(initialSeconds: Double = 10.0) {
+    data class Range(val startSeconds: Double, val endSeconds: Double)
+
+    var durationSeconds = bounded(initialSeconds)
+        private set
+    var followingLatest = true
+        private set
+    private var manualStart = 0.0
+
+    fun rangeAt(latestSeconds: Double): Range {
+        val start = if (followingLatest) latestSeconds - durationSeconds else manualStart
+        return Range(start, start + durationSeconds)
+    }
+
+    fun setDuration(seconds: Double) {
+        durationSeconds = bounded(seconds)
+    }
+
+    fun followLatest() {
+        followingLatest = true
+    }
+
+    fun panTo(startSeconds: Double) {
+        require(startSeconds.isFinite())
+        manualStart = startSeconds
+        followingLatest = false
+    }
+
+    fun zoomBy(factor: Double, anchorFraction: Double, latestSeconds: Double) {
+        require(factor.isFinite() && factor > 0)
+        val oldRange = rangeAt(latestSeconds)
+        val fraction = anchorFraction.coerceIn(0.0, 1.0)
+        val anchor = oldRange.startSeconds + fraction * durationSeconds
+        durationSeconds = bounded(durationSeconds * factor)
+        if (!followingLatest) manualStart = anchor - fraction * durationSeconds
+    }
+
+    private fun bounded(seconds: Double): Double {
+        require(seconds.isFinite() && seconds > 0)
+        return seconds.coerceIn(0.1, 3600.0)
+    }
+}
